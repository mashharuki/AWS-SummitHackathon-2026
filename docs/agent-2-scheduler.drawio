        <mxCell id="sub" value="タスクを作業ステップに分解し、締切から逆算して3バンドガントに配置する（意思決定は時刻アンカー）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#6B7280;" vertex="1" parent="1">
