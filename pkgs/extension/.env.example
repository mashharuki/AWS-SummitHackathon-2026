# SABOROU v2 Chrome 拡張 環境変数テンプレート
# このファイルを .env.local にコピーして使う（.env.local は git 管理外）:
#   cp .env.example .env.local

# --- AWS バックエンド（デプロイ済み共有リソース。そのまま使ってよい）---
VITE_API_URL=https://71m86enw87.execute-api.ap-northeast-1.amazonaws.com

# --- Cognito 認証（デプロイ済み共有リソース。そのまま使ってよい）---
VITE_COGNITO_DOMAIN=https://saborou-auth-dev.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=5mthfmer1a05dhocs6r5mu49lq

# --- AgentCore Gateway（MCP）---
# 現在は未使用（拡張は Hono API 直叩きで動作する）。空のままでよい。
VITE_AGENTCORE_GATEWAY_URL=

# --- ElevenLabs（音声）---
# 音声対話を使う場合のみ設定する。未設定でも「いいよ」ボタンで全フローが動く。
# ElevenLabs ダッシュボードで Conversational AI Agent を作成して Agent ID を貼る。
VITE_ELEVENLABS_AGENT_ID=
VITE_ELEVENLABS_SIGNED_URL=

# --- Chrome 拡張のリダイレクト URI ---
# manifest.json の固定 key により Extension ID は全員共通
# （klnbcafcphlnmbdbjgmpdjfeimenokmj）。通常は空でよい。
VITE_EXTENSION_REDIRECT_URI=
